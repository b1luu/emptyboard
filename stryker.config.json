{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node --import tsx --test \"tests/*.test.ts\"" },
  "mutate": [
    "server/services/time-window.ts",
    "server/services/availability.ts",
    "server/soc/parser.ts",
    "server/services/schedule-sync.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "ignoreStatic": false,
  "checkers": [],
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "thresholds": { "high": 80, "low": 60, "break": 84 }
}
